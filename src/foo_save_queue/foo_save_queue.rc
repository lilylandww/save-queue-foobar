#include <windows.h>
#include "resource.h"

// ---------------------------------------------------------------------------
// Version information block. foobar2000 reads this for the component's
// file/product version; keep the numbers in lock-step with
// DECLARE_COMPONENT_VERSION() in main.cpp.
// ---------------------------------------------------------------------------

#define STRINGIFY2(x) #x
#define STRINGIFY(x) STRINGIFY2(x)
#define VER_FILE_STR STRINGIFY(VER_MAJOR) "," STRINGIFY(VER_MINOR) "," STRINGIFY(VER_BUILD) "," STRINGIFY(VER_QFE)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_MAJOR,VER_MINOR,VER_BUILD,VER_QFE
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_BUILD,VER_QFE
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "save-queue-foobar"
            VALUE "FileDescription",  "foobar2000 component: Save Queue"
            VALUE "FileVersion",      VER_FILE_STR
            VALUE "InternalName",     "foo_save_queue"
            VALUE "OriginalFilename", "foo_save_queue.dll"
            VALUE "ProductName",      "Save Queue for foobar2000"
            VALUE "ProductVersion",   VER_FILE_STR
            VALUE "LegalCopyright",   "Component code: see LICENSE. SDK: see third_party/foobar2000-sdk/sdk-license.txt"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
